<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ============================================================
         精确闹钟：组间休息倒计时到点必须"准点"响（2026-09-24 加）

         【为什么需要它】
         通知不是我们自己掐着表发的，而是"跟安卓系统预约一个闹钟"。
         从安卓 12 起，想预约一个精确到秒的闹钟必须拿到这个权限，
         否则系统只给"大约那个时间前后"，在后台可能晚几分钟才响 ——
         对 90 秒的组间休息来说等于没提醒。

         【为什么不用 USE_EXACT_ALARM（那条更省事）】
         USE_EXACT_ALARM 会自动授予、用户还撤不掉，用起来当然更舒服。
         但 Google Play 只允许"核心功能就是闹钟或计时器"的 App 申请它，
         上架前要过审 + 在 Play 管理中心填声明。
         这个软件以后要上架，一次做对，别留下"上架前必须返工"的坑。

         【这个权限的行为，记住了免得以后踩】
         · 安卓 12/13：默认就给了
         · 安卓 14 起（本项目的 targetSdk 是 36）：默认是【拒绝】的，
           必须用户自己去系统设置里打开 —— 所以引导流程是主路径，不是兜底
         · 用户一旦撤销，安卓会【重启这个 App】并【清空所有已预约的精确闹钟】，
           所以每次回到前台都要重新查一遍、需要时重新预约

         【其余权限为什么不写在这里】
         POST_NOTIFICATIONS（通知）、WAKE_LOCK、RECEIVE_BOOT_COMPLETED、VIBRATE
         这几条由 local-notifications 插件和 haptics 插件自己带，
         打包时会自动合并进最终清单。手写一遍反而将来会跟插件打架。
         ============================================================ -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
</manifest>
